module usb3_pipe (
  local_clk,
  reset_n,
  ltssm_reset_n,
  phy_pipe_rx_datak,
  phy_pipe_rx_data,
  phy_pipe_rx_sync_head,
  phy_pipe_rx_start_block,
  phy_pipe_rx_valid,
  phy_pipe_tx_datak,
  phy_pipe_tx_data,
  phy_pipe_tx_sync_head,
  phy_pipe_tx_start_block,
  phy_pipe_tx_valid,
  phy_tx_detrx_lpbk,
  phy_tx_elecidle,
  phy_rx_elecidle,
  phy_rx_status,
  phy_power_down,
  phy_phy_status,
  phy_pwrpresent,
  phy_tx_deemph,
  phy_tx_margin,
  phy_tx_swing,
  phy_rx_polarity,
  phy_rx_termination,
  phy_rate,
  phy_elas_buf_mode,
  phy_tx_fifo_wrnum,
  link_in_datak,
  link_in_data,
  link_in_sync_head,
  link_in_start_block,
  link_in_active,
  link_out_datak,
  link_out_data,
  link_out_sync_head,
  link_out_start_block,
  link_out_active,
  link_out_skp_inhibit,
  link_out_skp_defer,
  link_out_stall,
  ltssm_state,
  ltssm_tx_detrx_lpbk,
  ltssm_tx_elecidle,
  ltssm_power_down,
  ltssm_power_go,
  ltssm_power_ack,
  ltssm_power_err,
  ltssm_hot_reset,
  ltssm_loopback,
  ltssm_local_loopback,
  ltssm_training,
  ltssm_train_hot_reset,
  ltssm_train_rxeq,
  ltssm_train_rxeq_pass,
  ltssm_train_active,
  ltssm_train_config,
  ltssm_train_idle,
  ltssm_train_idle_pass,
  ltssm_train_ts1,
  ltssm_train_ts2,
  ltssm_compliance,
  ltssm_warm_reset,
  lfps_recv_active,
  lfps_recv_poll_u1,
  lfps_recv_ping,
  lfps_recv_reset,
  lfps_recv_u2lb,
  lfps_recv_u3,
  partner_detect,
  partner_looking,
  partner_detected,
  ltssm_rate,
  ltssm_rate_changed,
  dbg_state
)
;
input local_clk;
input reset_n;
output ltssm_reset_n;
input [3:0] phy_pipe_rx_datak;
input [63:0] phy_pipe_rx_data;
input [3:0] phy_pipe_rx_sync_head;
input phy_pipe_rx_start_block;
input phy_pipe_rx_valid;
output [3:0] phy_pipe_tx_datak;
output [63:0] phy_pipe_tx_data;
output [3:0] phy_pipe_tx_sync_head;
output phy_pipe_tx_start_block;
output phy_pipe_tx_valid;
output phy_tx_detrx_lpbk;
output phy_tx_elecidle;
input phy_rx_elecidle;
input [2:0] phy_rx_status;
output [1:0] phy_power_down;
input phy_phy_status;
input phy_pwrpresent;
output [1:0] phy_tx_deemph;
output [2:0] phy_tx_margin;
output phy_tx_swing;
output phy_rx_polarity;
