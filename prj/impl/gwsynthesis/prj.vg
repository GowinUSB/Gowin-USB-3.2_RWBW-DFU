    .cc_orient_Z(cc_orient_Z[1]),
    .I_RADDR_Z(I_RADDR_Z[2:1])
);
  I2C_MASTER_Top u_i2c_master_top (
    .I_TX_EN_Z(I_TX_EN_Z),
