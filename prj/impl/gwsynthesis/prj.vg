module I2C_MASTER_Top (
  I_TX_EN_Z,
  phy_resetn_o,
  fclk_d,
  I_RX_EN_Z,
  I_RADDR_Z,
  I_WADDR_Z,
  I_WDATA_Z,
  n16_6_3,
  O_RDATA_0,
  O_RDATA_1,
  O_RDATA_7,
  scl,
  sda
)
;
input I_TX_EN_Z;
input phy_resetn_o;
input fclk_d;
input I_RX_EN_Z;
input [2:1] I_RADDR_Z;
input [2:0] I_WADDR_Z;
input [7:0] I_WDATA_Z;
output n16_6_3;
output O_RDATA_0;
output O_RDATA_1;
output O_RDATA_7;
inout scl;
inout sda;
wire SCL_in;
wire SDA_in;
wire scl_padoen_o;
wire sda_padoen_o;
wire VCC;
wire GND;
  IOBUF SCL_iobuf (
    .O(SCL_in),
    .IO(scl),
    .I(GND),
    .OEN(scl_padoen_o) 
);
  IOBUF SDA_iobuf (
    .O(SDA_in),
    .IO(sda),
    .I(GND),
    .OEN(sda_padoen_o) 
);
  \~i2c_master.I2C_MASTER_Top  u_i2c_master (
    .I_TX_EN_Z(I_TX_EN_Z),
    .phy_resetn_o(phy_resetn_o),
    .fclk_d(fclk_d),
    .I_RX_EN_Z(I_RX_EN_Z),
    .SCL_in(SCL_in),
    .SDA_in(SDA_in),
    .I_RADDR_Z(I_RADDR_Z[2:1]),
    .I_WADDR_Z(I_WADDR_Z[2:0]),
    .I_WDATA_Z(I_WDATA_Z[7:0]),
    .n16_6_3(n16_6_3),
    .scl_padoen_o(scl_padoen_o),
    .sda_padoen_o(sda_padoen_o),
    .O_RDATA_0(O_RDATA_0),
    .O_RDATA_1(O_RDATA_1),
    .O_RDATA_7(O_RDATA_7)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* I2C_MASTER_Top */
module gw_i2c_master (
  phy_resetn_o,
  fclk_d,
  fusb_int_n_d,
  n16_6_3,
  phy_pwrpresent,
  cc_orient_Z,
  scl,
  sda
)
;
input phy_resetn_o;
input fclk_d;
input fusb_int_n_d;
